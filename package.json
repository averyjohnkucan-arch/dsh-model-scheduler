{
  "name": "dsh-model-scheduler",
  "version": "0.1.5",
  "type": "module",
  "description": "Cooperative model admission, idle unloading and background GPU yielding for DeepSeek Harness.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check client.js"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": "0.2.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/averyjohnkucan-arch/dsh-model-scheduler.git"
  }
}
