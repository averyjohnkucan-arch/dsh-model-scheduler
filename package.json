{
  "name": "dsh-model-scheduler",
  "version": "0.2.1",
  "type": "module",
  "description": "Cooperative model admission, idle unloading and background GPU yielding for DeepSeek Harness.",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check index.js && node --check client.js && node --check lib/activity.js && node --check lib/indicators.js && node --check scripts/verify-providers.mjs",
    "build": "node scripts/build-client.mjs",
    "check:dsh": "node scripts/check-dsh-compatibility.mjs"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-subagent"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/averyjohnkucan-arch/dsh-model-scheduler.git"
  },
  "devDependencies": {
    "react": "^18.2.0",
    "react-test-renderer": "^18.2.0"
  }
}
